# ── Used by local runs AND by docker compose ────────────────────────────────

# REQUIRED (>= 32 chars). The app refuses to start in production without it.
# ./deploy.sh fills it in automatically if empty. Manually:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Number of reverse proxies in front of the app (one HTTPS proxy: 1; none: 0).
# The proxies must send X-Forwarded-For and X-Forwarded-Proto, and only they may
# reach the app's port; otherwise login rate limiting by IP doesn't work.
# README: "Behind an HTTPS reverse proxy". The app logs a warning if it doesn't match.
TRUSTED_PROXY_COUNT=0

# Session cookies only over HTTPS (default true). Set to false ONLY to test the
# production build over http://localhost. WebCrypto needs HTTPS or localhost anyway.
# SESSION_COOKIE_SECURE=false

# Upload limits. Sizes accept 500M, 20G, 1T or plain bytes; 0 = unlimited.
# Files are uploaded in 4 MB encrypted pieces, so any file size works.
# MAX_FILE_SIZE=0             # largest single file
# USER_STORAGE_QUOTA=0        # per user: all files in albums they own (incl. members' uploads)
# MIN_FREE_DISK_SPACE=1G      # uploads that would leave less free space are refused
# UPLOAD_EXPIRY_HOURS=168     # unfinished uploads can be resumed this long
# SESSION_IDLE_TIMEOUT_MINUTES=120  # sign out after this long without activity

# ── Local runs only (python -m src.app / gunicorn on the host) ──────────────
# Docker ignores these: the container layout is fixed in the Dockerfile.

# production (default) | development (debug, cookies over HTTP allowed)
APP_ENV=production

# Folder for everything the app writes: <DATA_DIR>/secure_gallery.db and
# <DATA_DIR>/uploads/. Relative paths are resolved from the project root.
# Default: run   (excluded from git; Docker always uses /data)
DATA_DIR=run
